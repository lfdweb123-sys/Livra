<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Livra</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>livra</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Permissions iOS — OBLIGATOIRES : sans description, iOS ferme l'app
	     immédiatement au premier accès à la caméra/position/micro, contrairement
	     à Android qui est plus tolérant. Toutes en français. -->
	<key>NSCameraUsageDescription</key>
	<string>Livra a besoin de l'appareil photo pour prendre en photo vos documents d'identité, votre véhicule et vos produits.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Livra a besoin d'accéder à vos photos pour choisir une image de profil ou de produit.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Livra a besoin de votre position pour vous proposer des livraisons/courses à proximité et vous guider jusqu'à destination.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Livra a besoin de votre position, y compris en arrière-plan, pour continuer à vous guider et vous proposer des courses pendant une livraison en cours.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Livra a besoin du microphone pour les appels vocaux avec les clients, vendeurs et livreurs.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Livra utilise le Bluetooth pour permettre l'utilisation d'un casque ou kit mains libres pendant un appel.</string>
	<key>NSContactsUsageDescription</key>
	<string>Livra peut accéder à vos contacts pour faciliter le partage et l'invitation de proches.</string>
	<!-- Modes d'arrière-plan: audio (appels en cours), fetch/notifications
	     distantes (FCM), position (suivi pendant une livraison/course en
	     cours). Le mode "voip" pour les appels entrants natifs (PushKit)
	     nécessite en plus une capacité Xcode dédiée + un fichier
	     d'habilitations — à activer manuellement dans Xcode sur le Mac
	     (Signing & Capabilities > + Capability > Background Modes > Voice
	     over IP), impossible à préconfigurer ici sans risquer un fichier
	     d'habilitations invalide qui bloquerait la signature du build. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
