# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client (admin dashboard)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=livra
R2_PUBLIC_URL=https://cdn.livra.app

# FeexPay
FEEXPAY_API_KEY=fp_xxx
FEEXPAY_SHOP_ID=xxx

# Verzapay
VERZAPAY_SECRET_KEY=vpz_sk_xxx

# Cartographie : OpenStreetMap (Nominatim + OSRM), gratuit, sans clé API
# ni carte bancaire. Rien à configurer ici.

# Brevo
BREVO_API_KEY=

# Secret interne — génère ta propre valeur avec `openssl rand -hex 32`,
# ne jamais réutiliser celle d'un exemple ou d'un chat. Sert à protéger
# /api/cron/reconcile-payments (header x-cron-secret).
INTERNAL_API_SECRET=change_me

# Twilio Programmable Voice — voir backend/lib/twilio.js pour le détail des
# étapes de configuration (TwiML App + Push Credential Android).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_ANDROID_PUSH_CREDENTIAL_SID=
