rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Helpers ─────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return isSignedIn() ? userDoc().role : null;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().isActive == true;
    }

    // ───────── users ─────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['client', 'driver', 'vendor']; // pas d'auto-promotion admin
      allow update: if (isOwner(userId) || isAdmin())
                    // un non-admin ne peut jamais changer son propre rôle ou isActive
                    && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']));
      allow delete: if isAdmin();
    }

    // ───────── vendors ─────────
    match /vendors/{vendorId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    || (isOwner(resource.data.ownerId)
                        // le vendeur ne touche ni à son statut ni à sa commission
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'commission', 'ownerId']));
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || isOwner(get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId);
      }
    }

    // ───────── drivers ─────────
    match /drivers/{driverId} {
      allow read: if isSignedIn(); // position/rating visibles pendant une course en cours
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    || (isOwner(resource.data.ownerId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ownerId']));
      allow delete: if isAdmin();
    }

    // ───────── orders ─────────
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.clientId)
                  || (resource.data.vendorId != null && isOwner(get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId))
                  || (resource.data.driverId != null && isOwner(get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.ownerId));

      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.paymentStatus == 'pending';

      // updates: client peut seulement annuler tant que pending ; vendeur/chauffeur avancent le statut ; admin fait tout
      allow update: if isAdmin()
                    || (isOwner(resource.data.clientId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled')
                    || (resource.data.vendorId != null
                        && isOwner(get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerId)
                        && request.resource.data.status in ['accepted', 'preparing', 'picked_up'])
                    || (resource.data.driverId != null
                        && isOwner(get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.ownerId)
                        && request.resource.data.status in ['picked_up', 'delivering', 'delivered']);

      allow delete: if isAdmin();
    }

    // ───────── rides ─────────
    match /rides/{rideId} {
      allow read: if isAdmin()
                  || isOwner(resource.data.clientId)
                  || (resource.data.driverId != null && isOwner(get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.ownerId));

      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (isOwner(resource.data.clientId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled')
                    || (resource.data.driverId != null
                        && isOwner(get(/databases/$(database)/documents/drivers/$(resource.data.driverId)).data.ownerId)
                        && request.resource.data.status in ['accepted', 'arriving', 'in_progress', 'completed']);

      allow delete: if isAdmin();
    }

    // ───────── wallets (écriture serveur uniquement, via Admin SDK) ─────────
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ───────── payments (écrit uniquement par les webhooks côté serveur) ─────────
    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false;
    }

    // ───────── notifications (créées côté serveur uniquement) ─────────
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      // le user peut seulement marquer comme lu
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ───────── disputes (litiges) ─────────
    match /disputes/{disputeId} {
      allow read: if isAdmin() || isOwner(resource.data.raisedBy) || isOwner(resource.data.against);
      allow create: if isSignedIn() && request.resource.data.raisedBy == request.auth.uid
                    && request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ───────── commission_config ─────────
    match /commission_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
